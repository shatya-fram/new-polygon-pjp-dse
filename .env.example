# ── Connection 1: Overture Maps (no key needed) ──────────────────────
OVERTURE_RELEASE=2026-07-22.0
OVERTURE_S3_BASE=s3://overturemaps-us-west-2/release
OVERTURE_MIN_CONFIDENCE=0.4

# ── Connection 2: Google Places API (New) — optional ─────────────────
# Leave blank to run Overture-only. Enable in Cloud Console:
#   "Places API (New)" + "Geocoding API"
GOOGLE_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────
# Own database. Nothing here is shared with the IM3 / 3ID systems.
DB_PATH=data/poi_pulldown.db

# ── Query guardrails ─────────────────────────────────────────────────
DEFAULT_RADIUS_M=1500
MAX_RADIUS_M=25000
MAX_RESULTS=2000

# ── DuckDB tuning ────────────────────────────────────────────────────
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# ── Map defaults ─────────────────────────────────────────────────────
DEFAULT_LAT=-6.1872609
DEFAULT_LON=106.8153029
DEFAULT_PLACE=Pasar Tanah Abang, Jakarta Pusat

NOMINATIM_UA=api-location-pulldown/1.0 (contact: you@example.com)
SECRET_KEY=change-me
PORT=5000

# /opt/pjp-dse/.env on the server. Copy, fill in, chmod 600.
#
# WHAT MUST NOT BE COPIED FROM THE LAPTOP
#   SECRET_KEY      generate a new one here, never reuse the local value
#   GOOGLE_API_KEY  leave blank; this instance does no pulling and a key on
#                   a reachable box is a bill waiting to happen

PUBLIC_MODE=1

# One page is published, not the application. Map Workspace answers; every
# other page and every endpoint it does not need returns 404. The allowlist
# is config.WORKSPACE_READS -- ten paths, enumerated, fail closed.
WORKSPACE_ONLY=1
# Generate on the server, never reuse the laptop's. The app refuses
# to start in PUBLIC_MODE with this empty or left at the default:
#     sed -i "s|^SECRET_KEY=.*|SECRET_KEY=$(openssl rand -hex 32)|" .env
SECRET_KEY=

# Bind to loopback only. nginx is the only thing that should reach gunicorn;
# binding 0.0.0.0 would put the application on the internet with no password
# in front of it, whatever nginx is configured to do.
# 8096, matching deploy/gunicorn.conf.py. NOT 5002 — that is the
# local development port, and setting it here would override the
# server default and leave nginx proxying to nothing.
BIND=127.0.0.1:8096
BEHIND_PROXY=1

DB_PATH=/opt/pjp-dse/data/poi_pulldown.db

# Samples: preview in the browser, never kept on this server.
SAMPLE_STORE=off
SAMPLE_MODEL_MAX=150000

# The three regions this application covers. Anything outside is refused at
# import and again when a layer is served.
PJP_REGIONS=INNER JAKARTA,OUTER JAKARTA,WEST JAVA
PJP_SCOPE_PROV=DKI JAKARTA,JAWA BARAT,BANTEN

DEFAULT_LAT=-6.1872609
DEFAULT_LON=106.8153029

WEB_WORKERS=3
WEB_TIMEOUT=180
LOG_LEVEL=info
